    "typecheck": {"label":"TypeScript","command":"npm","args":["run","typecheck"]},
    "tests": {"label":"Full regression suite","command":"npm","args":["test"]},
    "sync-smoke": {"label":"Expanded sync intent smoke","command":"node","args":["scripts/run-expanded-sync-intent-model.mjs"],"env":{"SYNC_INTENT_PROPERTY_SEED_COUNT":"129","SYNC_INTENT_PROPERTY_EVIDENCE_PATH":".agent-expanded-model-evidence.json"}},
