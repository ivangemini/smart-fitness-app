{
  "schemaVersion": 1,
  "repository": "ivangemini/smart-fitness-app",
  "defaultBaseCandidates": ["origin/main", "main"],
  "nodes": [
    {"id":"docs","label":"Documentation","paths":["AGENTS.md","PROJECT_MAP.md","PROJECT_LEARNINGS.md","README.md","docs/**"],"authority":"mobile documentation layer","changeClasses":["docs"],"validation":["agent-integrity"]},
    {"id":"agent-tooling","label":"Agent tooling","paths":["docs/agent/**","scripts/agent-*.mjs","scripts/check-agent-navigation.mjs","config/agent-project-graph.json"],"authority":"mobile agent infrastructure","changeClasses":["agent-tooling"],"validation":["agent-integrity","agent-tooling-tests"]},
    {"id":"routing","label":"Expo Router and root composition","paths":["src/app/**"],"authority":"mobile navigation/composition","changeClasses":["ui","routing"],"validation":["typecheck","tests"]},
    {"id":"home","label":"Home","paths":["src/features/home/**"],"authority":"mobile Home composition over bounded personal state and backend Social reads","changeClasses":["ui"],"validation":["typecheck","tests"]},
    {"id":"workouts","label":"Workouts and exercises","paths":["src/features/workouts/**","src/features/exercises/**"],"authority":"mobile private fitness feature over local/synced state","changeClasses":["ui","private-fitness"],"validation":["typecheck","tests"]},
    {"id":"nutrition","label":"Nutrition","paths":["src/features/nutrition/**"],"authority":"mobile private fitness feature over local/synced state","changeClasses":["ui","private-fitness"],"validation":["typecheck","tests"]},
    {"id":"progress","label":"Progress","paths":["src/features/progress/**"],"authority":"mobile derived analytics over canonical history","changeClasses":["ui","analytics"],"validation":["typecheck","tests"]},
    {"id":"goals","label":"Goals","paths":["src/features/goals/**"],"authority":"mobile goal presentation over fitness-profile/synced goal authority","changeClasses":["ui","private-fitness"],"crossRepo":"sync-contract-review","validation":["typecheck","tests"]},
    {"id":"labs","label":"Labs / Analyses","paths":["src/features/labs/**"],"authority":"backend server-authoritative Labs domain","changeClasses":["ui","server-authoritative","privacy-sensitive"],"crossRepo":"backend-contract-review","validation":["typecheck","tests"]},
    {"id":"coach","label":"Coach","paths":["src/features/coach/**"],"authority":"backend Coach run/orchestration authority with mobile presentation","changeClasses":["ui","server-authoritative","privacy-sensitive"],"crossRepo":"backend-contract-review","validation":["typecheck","tests"]},
    {"id":"companion","label":"Companion","paths":["src/features/companion/**"],"authority":"mobile presentation/derived progression over reviewed contracts","changeClasses":["ui"],"validation":["typecheck","tests"]},
    {"id":"social","label":"Social and Stories","paths":["src/features/social/**"],"authority":"backend server-authoritative Social/Stories domain","changeClasses":["ui","server-authoritative","privacy-sensitive"],"crossRepo":"backend-contract-review","validation":["typecheck","tests"]},
    {"id":"knowledge","label":"Knowledge and Learning","paths":["src/features/knowledge/**"],"authority":"backend canonical Knowledge and account-owned learning authority","changeClasses":["ui","server-authoritative"],"crossRepo":"backend-contract-review","validation":["typecheck","tests"]},
    {"id":"health","label":"Health integrations","paths":["src/features/health/**"],"authority":"mobile native health integration over platform authority","changeClasses":["ui","native-sensitive","privacy-sensitive"],"validation":["typecheck","tests","expo-export","expo-doctor"]},
    {"id":"notifications","label":"Notifications","paths":["src/features/notifications/**"],"authority":"mobile notification UX plus backend delivery authority","changeClasses":["ui","native-sensitive","server-authoritative"],"crossRepo":"backend-contract-review","validation":["typecheck","tests","expo-export","expo-doctor"]},
    {"id":"profile-settings","label":"Profile, settings and onboarding","paths":["src/features/profile/**","src/features/settings/**","src/features/onboarding/**"],"authority":"mobile profile/settings UX over local and account authority","changeClasses":["ui"],"validation":["typecheck","tests"]},
    {"id":"state","label":"Application state and persistence","paths":["src/context/**","src/storage/**"],"authority":"mobile authoritative local private fitness state and persistence","changeClasses":["state","persistence","high-fan-out"],"crossRepo":"sync-contract-review","validation":["typecheck","tests"]},
    {"id":"sync","label":"Synchronization","paths":["src/cloud/**","src/context/SyncContext.tsx","src/context/applySyncPullResult.ts","src/context/SyncConflictResolutionController.ts"],"authority":"mobile sync orchestration over backend revision authority","changeClasses":["sync","high-fan-out","server-authoritative"],"crossRepo":"backend-sync-review","validation":["typecheck","tests","sync-smoke"]},
    {"id":"api","label":"Backend API client and DTO boundary","paths":["src/api/**"],"authority":"shared mobile-to-backend contract boundary","changeClasses":["api-contract","high-fan-out","server-authoritative"],"crossRepo":"backend-contract-review","validation":["typecheck","tests"]},
    {"id":"auth","label":"Authentication and session","paths":["src/auth/**"],"authority":"backend account/session/device authority with SecureStore client state","changeClasses":["auth","high-fan-out","privacy-sensitive","server-authoritative"],"crossRepo":"backend-auth-review","validation":["typecheck","tests"]},
    {"id":"shared-ui","label":"Shared UI, hooks and localization","paths":["src/components/**","src/hooks/**","src/localization/**","src/global.css"],"authority":"mobile shared presentation infrastructure","changeClasses":["ui","high-fan-out"],"validation":["typecheck","tests"]},
    {"id":"domain-shared","label":"Domain and shared helpers","paths":["src/domain/**","src/lib/**","src/data/**"],"authority":"mobile deterministic/shared implementation","changeClasses":["domain","high-fan-out"],"validation":["typecheck","tests"]},
    {"id":"capabilities-config","label":"Capabilities and runtime configuration","paths":["src/capabilities/**","src/config/**","src/constants/**","config/**"],"authority":"mobile capability/configuration boundary","changeClasses":["config","high-fan-out"],"validation":["typecheck","tests"]},
    {"id":"observability","label":"Observability and diagnostics","paths":["src/observability/**"],"authority":"mobile privacy-bounded observability","changeClasses":["observability","privacy-sensitive"],"validation":["typecheck","tests"]},
    {"id":"assets","label":"Application assets","paths":["assets/**"],"authority":"mobile bundled assets","changeClasses":["assets","ota-safe-candidate"],"validation":["expo-export"]},
    {"id":"native-release","label":"Native, dependency and release configuration","paths":["app.json","app.config.ts","eas.json","package.json","package-lock.json","ios/**","android/**"],"authority":"mobile native/build configuration","changeClasses":["native-sensitive","release-sensitive","high-fan-out"],"validation":["agent-integrity","typecheck","tests","release-config","expo-export","expo-doctor"]},
    {"id":"ci","label":"CI and release automation","paths":[".github/workflows/**","scripts/validate-release-expo-config.mjs","scripts/check-repository-file-lines.mjs","scripts/check-changed-file-lines.mjs"],"authority":"mobile repository validation/release automation","changeClasses":["ci","release-sensitive","high-fan-out"],"validation":["agent-integrity","agent-tooling-tests","typecheck","tests","expo-export","expo-doctor"]},
    {"id":"backend-api","label":"Backend API trust boundary","paths":["@backend/api"],"authority":"Fastify routes and application services own server API semantics","repository":"ivangemini/smart-fitness-backend","external":true,"changeClasses":["backend"],"validation":[]},
    {"id":"backend-sync","label":"Backend sync authority","paths":["@backend/sync"],"authority":"backend revision/idempotency/conflict/tombstone persistence","repository":"ivangemini/smart-fitness-backend","external":true,"changeClasses":["backend","sync"],"validation":[]},
    {"id":"backend-auth","label":"Backend auth/session authority","paths":["@backend/auth"],"authority":"backend accounts, sessions, devices and refresh-token authority","repository":"ivangemini/smart-fitness-backend","external":true,"changeClasses":["backend","auth"],"validation":[]},
    {"id":"backend-labs","label":"Backend Labs authority","paths":["@backend/labs"],"authority":"backend Labs documents/results/processing/ownership authority","repository":"ivangemini/smart-fitness-backend","external":true,"changeClasses":["backend","privacy-sensitive"],"validation":[]},
    {"id":"backend-social","label":"Backend Social/Stories authority","paths":["@backend/social"],"authority":"backend Social, Stories, relationships, notifications and moderation authority","repository":"ivangemini/smart-fitness-backend","external":true,"changeClasses":["backend","privacy-sensitive"],"validation":[]},
    {"id":"backend-knowledge","label":"Backend Knowledge/Learning authority","paths":["@backend/knowledge"],"authority":"backend canonical Knowledge, learning state and editorial authority","repository":"ivangemini/smart-fitness-backend","external":true,"changeClasses":["backend"],"validation":[]},
    {"id":"backend-coach","label":"Backend Coach authority","paths":["@backend/coach"],"authority":"backend Coach orchestration, deterministic workers, findings and confirmation authority","repository":"ivangemini/smart-fitness-backend","external":true,"changeClasses":["backend","privacy-sensitive"],"validation":[]},
    {"id":"backend-admin","label":"Backend Admin production boundary","paths":["@backend/admin"],"authority":"backend/admin-console operational surface with production deployment boundary","repository":"ivangemini/smart-fitness-backend","external":true,"changeClasses":["backend","production-sensitive"],"validation":[]}
  ],
